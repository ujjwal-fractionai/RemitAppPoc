# Copy to POC/.env and fill in. Never commit .env.
# (server.js reads POC/.env first, then the repo-root .env)

# Required: Gemini API key from https://aistudio.google.com/apikey
# Only de-identified numbers/codes are sent (no names, IDs or dates).
GEMINI_API_KEY=

# Optional: Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: where the server listens (default 127.0.0.1:3000 = this machine only).
# Set HOST=0.0.0.0 to allow other computers on the network; put HTTPS + a login in front first.
PORT=3000
HOST=127.0.0.1

# Passcode for the app page (required when HOST is not 127.0.0.1). Use 12+ characters; share it only with billing staff.
APP_PASSCODE=

# Optional: key that signs the login cookie (default: derived from APP_PASSCODE). Any long random string,
# e.g. `openssl rand -hex 32`. Changing it (or APP_PASSCODE) signs everyone out. Set the same value on every server.
SESSION_SECRET=

# Supabase (POC v2: stores DEMO documents only). Project Settings → API Keys.
SUPABASE_URL=https://vzocbrfhfwnschrgqxds.supabase.co
# The SECRET key (sb_secret_… or the legacy service_role key), NOT the anon/publishable key. Server-side only.
SUPABASE_SECRET_KEY=
